# Reference copy of the env file that tells BMO how to reach Ironic.
# run-demo.sh writes this same content into
# <baremetal-operator repo>/config/default/ironic.env
DEPLOY_KERNEL_URL=
DEPLOY_RAMDISK_URL=
IRONIC_ENDPOINT=https://ironic.baremetal-operator-system.svc
IRONIC_CACERT_FILE=/opt/metal3/certs/ca/tls.crt
IRONIC_INSECURE=false
